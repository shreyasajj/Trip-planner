# ---- server ----
PORT=3000
# Where db.json and uploaded bill photos live (default: ./data)
# DATA_DIR=/data

# ---- MQTT (live location) ----
# Point at your Mosquitto broker. Examples:
#   mqtt://192.168.1.10:1883
#   mqtts://broker.example.com:8883
MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=trip
# MQTT_PASSWORD=secret

# ---- flight delay lookups (optional but recommended) ----
# Option A (recommended): AeroDataBox via RapidAPI — free tier available
#   https://rapidapi.com/aedbx-aedbx/api/aerodatabox
# FLIGHT_API_PROVIDER=aerodatabox
# FLIGHT_API_KEY=your-rapidapi-key

# Option B: aviationstack — free tier available
#   https://aviationstack.com
# FLIGHT_API_PROVIDER=aviationstack
# FLIGHT_API_KEY=your-access-key

# ---- receipt scanning with Claude vision (optional) ----
# Get a key at https://console.anthropic.com — enables "Scan with Claude" on bills:
# photo in, total + currency + line items out (for uneven splits).
# ANTHROPIC_API_KEY=sk-ant-...
# BILL_SCAN_MODEL=claude-opus-4-8

# ---- restaurant search ----
# Uses the public Overpass API by default; self-host one and point here if you like.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
